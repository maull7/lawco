APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=investalaw
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must exceed the Horizon JDIH worker timeout (1200 seconds).
REDIS_QUEUE_RETRY_AFTER=1500
HORIZON_PREFIX=investalaw_horizon:
HORIZON_NAME=investalaw-horizon
HORIZON_ALERT_EMAIL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Koneksi read-only ke DB scraper JDIH (dipakai `php artisan jdih:sync`) ----
# Di deploy scraper Docker-compose, port mysql dipublish ke 127.0.0.1:3307.
JDIH_DB_HOST=127.0.0.1
JDIH_DB_PORT=3307
JDIH_DB_DATABASE=jdih
JDIH_DB_USERNAME=
JDIH_DB_PASSWORD=
# Induk folder downloads hasil scraper (local_path di DB diawali "downloads/...").
# Local Windows: D:\...\scraping   |   Server Linux: /srv/scraping
JDIH_SCRAPER_ROOT=
# Fallback sector_id saat map per-source kosong atau ID-nya tidak dikenal (default 1).
JDIH_DEFAULT_SECTOR_ID=1
# Sektor Lawco per target website = ID tabel `sectors` (bukan nama).
# Isi nilai production untuk setiap source. Regulasi mewarisi sektor melalui
# kategori; pastikan kategori scraper juga sudah ada pada sektor tersebut.
JDIH_SECTOR_KOMDIGI=
JDIH_SECTOR_KEMENHUB=
JDIH_SECTOR_IMPORT=
# Hapus PDF di folder scraper (downloads/) setelah berhasil sync ke Lawco (hemat disk).
JDIH_CUT_SOURCE_FILES=true

VITE_APP_NAME="${APP_NAME}"
