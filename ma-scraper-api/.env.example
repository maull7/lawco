# Alamat bind server. 127.0.0.1 cukup untuk lokal, ngrok, dan cloudflared (tunnel konek ke localhost).
HOST=127.0.0.1
PORT=8001

# Wajib diisi jika memakai tunnel. Nilai sama dengan MA_SCRAPER_TOKEN di .env Laravel.
# Generate: openssl rand -hex 32
MA_SCRAPER_TOKEN=

# none | ngrok | cloudflare (bisa juga lewat argumen --tunnel)
TUNNEL=none

# ngrok: authtoken akun (atau sudah diset lewat `ngrok config add-authtoken`), dan domain statis opsional.
NGROK_AUTHTOKEN=
NGROK_URL=

# Cloudflare: kosong = quick tunnel (URL *.trycloudflare.com acak, berubah tiap restart).
# Isi token named tunnel untuk hostname tetap (atur Public Hostname -> http://localhost:8001 di dashboard).
CLOUDFLARE_TUNNEL_TOKEN=

# Masa tunggu (detik) setelah portal MA membalas verifikasi bot Cloudflare (403 challenge). Default 120.
# MA_COOLDOWN_CHALLENGE_SECONDS=30

# Batas waktu (detik) menunggu file PDF dari portal MA. Timeout dibalas 504 dan dicoba ulang otomatis oleh Laravel. Default 60.
# MA_PDF_TIMEOUT=60

# Jeda antar request ke portal MA (detik) + acak 0..JITTER. Jeda naik 2x otomatis saat portal lambat/timeout/429 (maks MAX).
# MA_MIN_GAP_SECONDS=3
# MA_GAP_JITTER_SECONDS=1
# MA_MAX_GAP_SECONDS=60
# MA_SLOW_RESPONSE_SECONDS=45
